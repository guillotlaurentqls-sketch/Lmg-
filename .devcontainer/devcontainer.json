{
  "name": "Movix",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "secrets": {
    "VITE_TMDB_API_KEY": { "description": "Clé API TMDB (gratuite sur themoviedb.org), indispensable pour afficher films et séries." }
  },
  "forwardPorts": [3000, 25565, 25569],
  "portsAttributes": {
    "3000": { "label": "Movix (site)", "onAutoForward": "openBrowser" },
    "25565": { "label": "API principale" },
    "25569": { "label": "Proxy embed" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start.sh"
}
